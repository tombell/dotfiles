################################################################################
# Windows
################################################################################

lalt - f: swm window grid 12 10 0 0 12 10
lalt - x: swm window grid 12 10 1 1 10 8
lalt - z: swm window grid 12 10 2 2 8 6

lalt - h: swm window grid 12 10 0 0 6 10
lalt - l: swm window grid 12 10 6 0 6 10

lalt + shift - h: swm window grid 12 10 0 0 8 10
lalt + shift - l: swm window grid 12 10 4 0 8 10

lalt - tab: swm window focus next

lalt + shift - ,: swm window move --display 1
lalt + shift - .: swm window move --display 2

lalt + ctrl - h: swm window swap left
lalt + ctrl - j: swm window swap down
lalt + ctrl - k: swm window swap up
lalt + ctrl - l: swm window swap right

################################################################################
# Spaces
################################################################################

ctrl - 1: swm space activate 1
ctrl - 2: swm space activate 2
ctrl - 3: swm space activate 3
ctrl - 4: swm space activate 4
ctrl - 5: swm space activate 5

lalt + shift - 1: swm window move --space 1
lalt + shift - 2: swm window move --space 2
lalt + shift - 3: swm window move --space 3
lalt + shift - 4: swm window move --space 4
lalt + shift - 5: swm window move --space 5

################################################################################
# Applications
################################################################################

alt - return:
  osascript -e 'if application id "com.superlogical.rex" is running then' \
            -e '  tell application "System Events"' \
            -e '    click menu item "New Window" of menu "File" of menu bar 1 of process "Rex"' \
            -e '  end tell' \
            -e 'end if' \
            -e 'tell application id "com.superlogical.rex" to activate' > /dev/null

alt + shift - return:
  osascript -e 'tell application "Helium" to make new window' \
            -e 'tell application "Helium" to activate' &> /dev/null

ralt - 1:
  open -a 1Password

ralt - 3:
  open -a T3\ Code\ \(Nightly\)

ralt - b:
  open -a Helium

ralt - c:
  open -a Calendar

ralt - d:
  open -a Discord

ralt - e:
  open -a Mail

ralt - f:
  osascript -e 'tell application "System Events"' \
            -e '  click menu item "New Finder Window" of menu "File" of menu bar 1 of process "Finder"' \
            -e 'end tell' > /dev/null

ralt - h:
  open -a Home

ralt - i:
  open -a "iPhone Mirroring"

ralt - m:
  open -a Messages

ralt - n:
  open -a Notes

ralt - p:
  open -a Photos

ralt - r:
  open -b com.superlogical.rex

ralt - t:
  open -a Telegram

ralt - v:
  open -a VMPal

ralt - x:
  open -a Xcode

################################################################################
# Home
################################################################################

lalt + ctrl - 1: shortcuts run "Main Bedroom"

lalt + ctrl - 2: shortcuts run "Guest Bedroom"

lalt + ctrl - 3: shortcuts run "Living Room"

lalt + ctrl - 4: shortcuts run "All Off"
