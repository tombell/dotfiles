#!/usr/bin/env bash
#
# rex-sessions — fuzzy find a Rex session with fzf and show it in the Rex app.
#
# Usage: rex-sessions [CLIENT]
#
# CLIENT is the Rex app to switch, given as a label or ID. Without it, Rex
# picks the app when exactly one is connected.

set -euo pipefail

client=${1:-}

sessions=$(rex ls --json | jq -r '.sessions[] | [.session_id, .label] | @tsv')

choice=$(
  printf '%s\n' "$sessions" |
    fzf --delimiter='\t' --with-nth=2 --prompt='session> ' --reverse
) || exit 0

session_id=${choice%%$'\t'*}

rex ${client:+-C "$client"} do session.select session_id="$session_id"
