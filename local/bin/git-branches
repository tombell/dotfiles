#!/usr/bin/env bash
#
# git branches — list local branches, grouping every <prefix>/<suffix> branch
# under a coloured <prefix>/ header. The default branch is listed first.

set -euo pipefail

# Default branch: origin's HEAD if set, else init.defaultBranch, main, or
# master. Only used if it exists locally.
if origin_head=$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null); then
  candidates=("${origin_head#origin/}")
else
  candidates=("$(git config init.defaultBranch || true)" main master)
fi
default_branch=''
for branch in "${candidates[@]}"; do
  if [ -n "$branch" ] && git show-ref -q --verify "refs/heads/$branch"; then
    default_branch=$branch
    break
  fi
done

# Keeps the default branch out of the sorted lists so it's only shown first.
exclude_default=()
if [ -n "$default_branch" ]; then
  exclude_default=(--exclude="refs/heads/$default_branch")
fi

# Discover the first path component of every namespaced branch.
prefixes=()
while IFS= read -r prefix; do
  prefixes+=("$prefix")
done < <(git for-each-ref --format='%(refname:lstrip=2)' refs/heads | awk -F/ 'NF>1 && !seen[$1]++ {print $1}')

# Colours — disabled when output isn't a terminal or NO_COLOR is set.
reset='' bold='' green='' red='' yellow='' blue='' bright_blue='' magenta='' cyan=''
git_color=never
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  reset=$'\e[0m'
  bold=$'\e[1m'
  green=$'\e[32m'
  red=$'\e[31m'
  yellow=$'\e[33m'
  blue=$'\e[34m'
  bright_blue=$'\e[94m'
  magenta=$'\e[35m'
  cyan=$'\e[36m'
  git_color=always
fi

group_colors=("$magenta" "$cyan" "$green" "$yellow" "$red" "$bright_blue")

# row_format <name suffix> — the suffix is padded with the name, so it can't
# contain colours (align counts escape codes towards the width).
row_format() {
  # Full ref name (incl. prefix) so it can be copied straight to `git checkout`.
  printf '%s' "%(if)%(HEAD)%(then)%(color:green)* %(color:bold green)%(else)  %(end)%(align:38)%(refname:short)$1%(end)%(color:reset)" \
    '  %(color:yellow)%(objectname:short)%(color:reset)' \
    '  %(color:dim)%(committerdate:relative)%(color:reset)' \
    '  %(color:blue)%(authorname)%(color:reset)'
}
fmt=$(row_format '')
default_fmt=$(row_format ' ◆')

group_printed=0

# list_refs <format> <for-each-ref args...>
list_refs() {
  local format=$1
  shift
  git for-each-ref --color="$git_color" --sort=-committerdate --format="$format" "$@"
}

# print_group <label> <colour> <ref pattern> [<branch to list first>]
print_group() {
  local label=$1 color=$2 out
  out=$(
    if [ -n "${4:-}" ]; then list_refs "$default_fmt" "refs/heads/$4"; fi
    list_refs "$fmt" ${exclude_default[@]+"${exclude_default[@]}"} "$3"
  )
  [ -n "$out" ] || return 0

  [ "$group_printed" = 1 ] && printf '\n'
  group_printed=1
  printf '%s%s%s%s\n%s\n' "$bold" "$color" "$label" "$reset" "$out"
}

# Main list: every local branch without a namespace (`*` doesn't match `/`).
print_group "Branches" "$blue" 'refs/heads/*' "$default_branch"

# One group per discovered prefix, cycling through header colours.
for i in ${prefixes[@]+"${!prefixes[@]}"}; do
  print_group "${prefixes[i]}/" "${group_colors[i % ${#group_colors[@]}]}" "refs/heads/${prefixes[i]}"
done
