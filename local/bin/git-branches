#!/usr/bin/env bash
#
# git branches — list local branches, grouping every <prefix>/<suffix> branch
# under a coloured <prefix>/ header.

set -euo pipefail

# Discover and deduplicate the first path component of every namespaced branch.
prefixes=()
while IFS= read -r name; do
  case "$name" in
  */*)
    prefix="${name%%/*}"
    prefix_exists=0
    for existing_prefix in "${prefixes[@]+"${prefixes[@]}"}"; do
      if [ "$prefix" = "$existing_prefix" ]; then
        prefix_exists=1
        break
      fi
    done
    [ "$prefix_exists" = 1 ] || prefixes+=("$prefix")
    ;;
  esac
done < <(git for-each-ref --sort=refname --format='%(refname:lstrip=2)' refs/heads)

# Colours — disabled when output isn't a terminal or NO_COLOR is set.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  reset=$'\e[0m'
  bold=$'\e[1m'
  dim=$'\e[2m'
  green=$'\e[32m'
  red=$'\e[31m'
  yellow=$'\e[33m'
  blue=$'\e[34m'
  bright_blue=$'\e[94m'
  magenta=$'\e[35m'
  cyan=$'\e[36m'
else
  reset=''
  bold=''
  dim=''
  green=''
  red=''
  yellow=''
  blue=''
  bright_blue=''
  magenta=''
  cyan=''
fi

group_colors=("$magenta" "$cyan" "$green" "$yellow" "$red" "$bright_blue")

sep=$'\x1f'
fmt="%(HEAD)${sep}%(refname:short)${sep}%(objectname:short)${sep}%(committerdate:relative)${sep}%(authorname)"

group_printed=0

# print_group <label> <colour> <for-each-ref args...>
print_group() {
  local label="$1" color="$2"
  shift 2
  local out
  out="$(git for-each-ref --sort=-committerdate --format="$fmt" "$@")"
  [ -z "$out" ] && return

  [ "$group_printed" = 1 ] && printf '\n'
  group_printed=1
  printf '%s%s%s%s\n' "$bold" "$color" "$label" "$reset"

  local head name sha date author marker nc padded
  while IFS="$sep" read -r head name sha date author; do
    if [ "$head" = '*' ]; then
      marker="${green}*${reset} "
      nc="${bold}${green}"
    else
      marker='  '
      nc=''
    fi

    # Full ref name (incl. prefix) so it can be copied straight to `git checkout`.
    padded="$(printf '%-38s' "$name")"
    printf '%s%s%s%s  %s%s%s  %s%s%s  %s%s%s\n' \
      "$marker" "$nc" "$padded" "$reset" \
      "$yellow" "$sha" "$reset" \
      "$dim" "$date" "$reset" \
      "$blue" "$author" "$reset"
  done <<EOF
$out
EOF
}

# Main list: every local branch without a namespace.
exclude_args=()
for p in "${prefixes[@]+"${prefixes[@]}"}"; do
  exclude_args+=(--exclude="refs/heads/$p")
done
print_group "Branches" "$blue" "${exclude_args[@]+"${exclude_args[@]}"}" refs/heads

# One group per discovered prefix, cycling through header colours.
group_color_index=0
for p in "${prefixes[@]+"${prefixes[@]}"}"; do
  color="${group_colors[$((group_color_index % ${#group_colors[@]}))]}"
  print_group "$p/" "$color" "refs/heads/$p"
  group_color_index=$((group_color_index + 1))
done
