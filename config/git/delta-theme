; vim: set ft=gitconfig:

[delta]
  ; Sagittarius A
  dark = true
  minus-style                   = syntax "#30202D"
  minus-non-emph-style          = syntax "#30202D"
  minus-emph-style              = syntax "#573543"
  minus-empty-line-marker-style = syntax "#30202D"

  plus-style                    = syntax "#1C2734"
  plus-non-emph-style           = syntax "#1C2734"
  plus-emph-style               = syntax "#30475B"
  plus-empty-line-marker-style  = syntax "#1C2734"

  line-numbers-plus-style       = "#8DBDE0"
  line-numbers-minus-style      = "#E39494"
  line-numbers-zero-style       = "#9B8294"
  line-numbers-left-style       = "#9B8294"
  line-numbers-right-style      = "#9B8294"

  file-decoration-style         = "#9B8294" overline underline
  file-style                    = "#F2B49D"
  commit-style                  = "#F5D49D"
  whitespace-error-style        = "#E39494" reverse

  hunk-header-style             = omit
