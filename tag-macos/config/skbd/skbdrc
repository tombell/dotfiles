################################################################################
# Windows
################################################################################

lalt - f: swm window grid 12:10:0:0:12:10
lalt - x: swm window grid 12:10:1:1:10:8
lalt - z: swm window grid 12:10:2:2:8:6

lalt - h: swm window grid 12:10:0:0:6:10
lalt - l: swm window grid 12:10:6:0:6:10

lalt + shift - h: swm window grid 12:10:0:0:8:10
lalt + shift - l: swm window grid 12:10:4:0:8:10

lalt - tab: swm window cycle --direction next

lalt + shift - ,: swm window display 1
lalt + shift - .: swm window display 2

lalt + ctrl - h: swm window swap --direction left
lalt + ctrl - j: swm window swap --direction down
lalt + ctrl - k: swm window swap --direction up
lalt + ctrl - l: swm window swap --direction right

################################################################################
# Applications
################################################################################

alt - return:
  osascript -e 'if application "Ghostty" is running then' \
            -e '  tell application "System Events"' \
            -e '    click menu item "New Window" of menu "File" of menu bar 1 of process "Ghostty"' \
            -e '  end tell' \
            -e 'else' \
            -e '  tell application "Ghostty" to activate' \
            -e 'end if' > /dev/null

alt + shift - return:
  osascript -e 'tell application "Google Chrome" to make new window' \
            -e 'tell application "Google Chrome" to activate' &> /dev/null

ralt - 1:
  open -a 1Password

ralt - b:
  open -a "Google Chrome"

ralt - c:
  open -a Calendar

ralt - d:
  open -a Discord

ralt - e:
  open -a Mail

ralt - f:
  osascript -e 'tell application "System Events"' \
            -e '  click menu item "New Finder Window" of menu "File" of menu bar 1 of process "Finder"' \
            -e 'end tell' > /dev/null

ralt - g:
  open -a Ghostty

ralt - h:
  open -a Home

ralt - m:
  open -a Messages

ralt - n:
  open -a Notes

ralt - p:
  open -a Photos

ralt - t:
  open -a Telegram

ralt - x:
  open -a Xcode

################################################################################
# Home
################################################################################

lalt + ctrl - 1: shortcuts run "Main Bedroom"

lalt + ctrl - 2: shortcuts run "Guest Bedroom"

lalt + ctrl - 3: shortcuts run "Living Room"

lalt + ctrl - 4: shortcuts run "All Off"
