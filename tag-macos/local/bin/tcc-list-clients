#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: $(basename "$0") [--system]"
  exit "${1:-1}"
}

system=false
case "${1:-}" in
  --system|--root)
    system=true
    shift
    ;;
  -h|--help)
    usage 0
    ;;
esac

if [ "$#" -ne 0 ]; then
  usage
fi

if $system; then
  db="/Library/Application Support/com.apple.TCC/TCC.db"
  sqlite=(sudo sqlite3)
else
  db="$HOME/Library/Application Support/com.apple.TCC/TCC.db"
  sqlite=(sqlite3)
fi

if $system; then
  sudo test -f "$db" || {
    echo "TCC DB not found at: $db" >&2
    exit 1
  }
elif [ ! -f "$db" ]; then
  echo "TCC DB not found at: $db" >&2
  exit 1
fi

"${sqlite[@]}" "$db" <<'SQL'
.headers on
.mode column
SELECT
  service,
  client,
  client_type,
  auth_value,
  auth_reason,
  auth_version,
  flags,
  datetime(last_modified, 'unixepoch') AS last_modified
FROM access
ORDER BY client;
SQL
